@startuml TasklyApp_Slide_Architecture
!theme plain
skinparam linetype ortho
skinparam padding 10
skinparam fontSize 12

title Taskly - Architecture Overview

' ====================================================
' LAYER 1: APP ENTRY
' ====================================================
package "APP" #FF6B6B {
    card TasklyApp [
        <b>TasklyApp</b>
        ---
        Initialize & Setup
    ]
}

' ====================================================
' LAYER 2: NAVIGATION
' ====================================================
package "NAVIGATION" #FFA726 {
    card ContentView [
        <b>ContentView</b>
        ---
        5 Tab Router
    ]
}

' ====================================================
' LAYER 3: MAIN VIEWS
' ====================================================
package "MAIN VIEWS" #FFD54F {
    card MainViews [
        <b>Home | Notes | Calendar</b>
        <b>Drawing | Schedule</b>
    ]
}

' ====================================================
' LAYER 4: SUB-VIEWS & SERVICES
' ====================================================
package "SUB-VIEWS & SERVICES" #81C784 {
    card SubViews [
        <b>Notes:</b> AddNote, NoteDetail, Folder
        <b>Calendar:</b> AddTask, EditTask
        <b>Drawing:</b> AddDrawing, Canvas
        <b>Schedule:</b> AddCourse, EditCourse
        ---
        <b>Services:</b> CalendarManager
        NotificationManager, NoteSaver
    ]
}

' ====================================================
' LAYER 5: UTILITIES & APIs
' ====================================================
package "UTILITIES & APIS" #FFE0B2 {
    card UtilitiesAPIs [
        <b>Utilities:</b> CanvasView, Extensions
        ---
        <b>Frameworks:</b> SwiftData | EventKit
        UserNotifications | PencilKit
    ]
}

' ====================================================
' LAYER 6: DATA MODELS
' ====================================================
package "DATA MODELS" #B2DFDB {
    card DataModels [
        <b>Folder | Note | TaskItem</b>
        <b>DrawingNote | Course | Home</b>
    ]
}

' ====================================================
' CONNECTIONS
' ====================================================
TasklyApp --> ContentView: init
ContentView --> MainViews: routes
MainViews --> SubViews: creates
SubViews --> UtilitiesAPIs: uses
UtilitiesAPIs --> DataModels: manages

@enduml